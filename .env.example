# ==============================================================================
# MortX Local Intelligence AI Engine — Production Environment Configuration
# ==============================================================================
# NOTE: All values below are placeholders. Populate with secrets in your secure
# deployment environment (.env / secret manager). Never commit real secrets.
# ==============================================================================

# Server Environment
NODE_ENV=production
PORT=5173

# Database & Cache
# DATABASE_URL=postgresql://user:password@localhost:5432/mortx
DATABASE_PATH=./data/mortx.db
REDIS_URL=redis://localhost:6379

# AI Provider Configuration (Google Gemini / OpenAI compatible)
GEMINI_API_KEY=your_gemini_api_key_here
AI_API_KEY=your_ai_api_key_here
AI_MODEL=gemini-1.5-flash
AI_TIMEOUT_MS=6000
AI_MAX_TOKENS=500
AI_TEMPERATURE=0.1

# Caching TTLs (in seconds)
CACHE_TTL_NEWS_SECONDS=600       # 10 minutes
CACHE_TTL_EVENTS_SECONDS=1800    # 30 minutes
CACHE_TTL_ALERTS_SECONDS=300     # 5 minutes
CACHE_TTL_PRICES_SECONDS=900     # 15 minutes
CACHE_TTL_GENERAL_SECONDS=300    # 5 minutes
CACHE_TTL_STATIC_SECONDS=3600    # 1 hour

# Rate Limiting (requests per minute window)
RATE_LIMIT_ANON_PER_MIN=60
RATE_LIMIT_AUTH_PER_MIN=120

# Background Ingestion Intervals (in milliseconds)
INGESTION_INTERVAL_NEWS_MS=900000       # 15 minutes
INGESTION_INTERVAL_EVENTS_MS=3600000    # 1 hour
INGESTION_INTERVAL_ALERTS_MS=1800000    # 30 minutes
INGESTION_INTERVAL_PRICES_MS=14400000   # 4 hours

# Guardrails & Guarded Limits
RETRIEVAL_MAX_LIMIT=25
FEED_FETCH_TIMEOUT_MS=5000
MAX_QUERY_LENGTH=500
