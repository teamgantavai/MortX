# ==========================================
# aaspaas AI Engine Environment Configuration
# ==========================================

# Server Environment
NODE_ENV=development
PORT=5173

# Database & Cache
# DATABASE_PATH=./data/mortx.db
# REDIS_URL=redis://localhost:6379

# AI Provider Configuration
# GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-1.5-flash
AI_TIMEOUT_MS=6000
AI_MAX_TOKENS=500
AI_TEMPERATURE=0.1

# Caching TTLs (seconds)
CACHE_TTL_NEWS_SECONDS=600
CACHE_TTL_GENERAL_SECONDS=300
CACHE_TTL_STATIC_SECONDS=3600

# Rate Limiting (requests per minute)
RATE_LIMIT_ANON_PER_MIN=60
RATE_LIMIT_AUTH_PER_MIN=120

# Guardrails & Guarded Limits
RETRIEVAL_MAX_LIMIT=25
FEED_FETCH_TIMEOUT_MS=5000
MAX_QUERY_LENGTH=500
